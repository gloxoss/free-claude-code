#!/bin/bash
# Start the free-claude-code proxy and launch Claude Code with OpenRouter (Llama 70B) backend

REPO_DIR="/mnt/c/Users/oussama/.gemini/antigravity/scratch/free-claude-code"

# Ensure uv is in PATH
export PATH="$HOME/.local/bin:$PATH"

# Check if port 8087 is already active
if ! lsof -i :8087 -t >/dev/null; then
    # Start proxy in background
    cd "$REPO_DIR" && MODEL="open_router/meta-llama/llama-3.1-70b-instruct" MODEL_OPUS="open_router/meta-llama/llama-3.1-70b-instruct" MODEL_SONNET="open_router/meta-llama/llama-3.1-70b-instruct" MODEL_HAIKU="open_router/meta-llama/llama-3.1-70b-instruct" uv run uvicorn server:app --host 0.0.0.0 --port 8087 --app-dir "$REPO_DIR" >/dev/null 2>&1 &
    # Give server a moment to start
    sleep 3
fi

# Launch Claude Code pointed at local proxy
export ANTHROPIC_AUTH_TOKEN="freecc"
export ANTHROPIC_BASE_URL="http://localhost:8087"

# Execute claude with all arguments passed
exec claude "$@"
